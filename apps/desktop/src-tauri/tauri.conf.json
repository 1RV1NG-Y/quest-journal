{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quest Journal",
  "version": "0.1.0",
  "identifier": "com.questjournal.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quest Journal",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
